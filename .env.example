# Luxuria Safes — environment variables required by /api/enquiry
#
# Set these in Vercel: Project → Settings → Environment Variables.
# Never commit real values. This file lists names only.

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Data centre hosts. This organisation is on the .com data centre.
ZOHO_ACCOUNTS_HOST=accounts.zoho.com
ZOHO_API_HOST=www.zohoapis.com
