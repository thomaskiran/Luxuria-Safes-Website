# Luxuria Safes — environment variables for /api/enquiry and /api/meta-capi
#
# Set these in Vercel: Project → Settings → Environment Variables.
# Never commit real values. This file lists names only.

ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Data centre hosts. This organisation is on the .com data centre.
ZOHO_ACCOUNTS_HOST=accounts.zoho.com
ZOHO_API_HOST=www.zohoapis.com

# Meta Conversions API (optional — both endpoints skip Meta while these are empty)
META_DATASET_ID=
META_CAPI_TOKEN=
# Set only while testing; events then appear under Events Manager → Test Events.
META_TEST_EVENT_CODE=
# META_GRAPH_VERSION=v23.0

# Shared secret the Zoho CRM webhook sends as the x-webhook-secret header.
CRM_WEBHOOK_SECRET=
